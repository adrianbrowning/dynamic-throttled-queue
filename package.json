{
  "name": "dynamic-throttled-queue",
  "version": "3.0.0",
  "type": "module",
  "description": "Dynamically throttles arbitrary code to execute between a minimum and maximum number of times per interval. Best for making throttled API requests.",
  "files": [
    "dist",
    "skills/configure-throttled-queue"
  ],
  "zshy": {
    "exports": {
      ".": "./src/dynamic-throttled-queue.ts"
    },
    "cjs": false
  },
  "scripts": {
    "build": "zshy",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:ts": "tsc --noEmit && tsc -p tsconfig.config.json",
    "lint:esl": "eslint --config eslint.config.ts \"src/**/*.{j,t}s{,x}\" \"eslint.config*.ts\" --cache --max-warnings=0",
    "lint:esl:fix": "pnpm lint:esl --fix",
    "lint:s": "eslint --config eslint.config.style.ts \"src/**/*.{j,t}s{,x}\" \"eslint.config*.ts\" --cache --max-warnings=0",
    "lint:fix": "pnpm lint:s --fix",
    "lint:knip": "knip",
    "lint:jscpd": "jscpd .",
    "lint": "pnpm lint:ts && pnpm lint:esl",
    "lint:e18e": "pnpm dlx @e18e/cli analyze",
    "bump": "bumpy add",
    "bump:status": "bumpy status",
    "skills:check": "intent maintainer check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianbrowning/dynamic-throttled-queue.git"
  },
  "keywords": [
    "node",
    "rate limit",
    "queue",
    "throttle",
    "throttled",
    "request",
    "tanstack-intent"
  ],
  "author": "Adrian Elton-Browning <gingacodemonkey@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adrianbrowning/dynamic-throttled-queue/issues"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.0",
    "@gingacodemonkey/config": "^0.1.0",
    "@tanstack/intent": "0.5.0",
    "@types/node": "^24.13.3",
    "@varlock/bumpy": "^1.18.1",
    "eslint": "^9.39.5",
    "husky": "9.1.7",
    "jiti": "^2.7.0",
    "jscpd": "^5.4.0",
    "knip": "6.26.0",
    "lint-staged": "17.6.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "zshy": "^0.8.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "module": "./dist/dynamic-throttled-queue.js",
  "types": "./dist/dynamic-throttled-queue.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dynamic-throttled-queue.d.ts",
      "default": "./dist/dynamic-throttled-queue.js"
    }
  },
  "packageManager": "pnpm@10.34.5",
  "imports": {
    "#src/*.ts": {
      "types": "./dist/*.d.ts",
      "gingacodemonkey:source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  }
}
